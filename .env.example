# Created by `npx convex dev` for project jayrr-videos (jayrr-dev)
CONVEX_DEPLOYMENT=dev:useful-donkey-136
VITE_CONVEX_URL=https://useful-donkey-136.convex.cloud

# Local Flatten library for /jayrr-sound and yarn seed:sounds
SOUND_LIBRARY_ROOT=C:\Users\Main\OneDrive\Sound Library\Flatten

# Inworld STT — Base64 key from Inworld Portal → API Keys
# Also set on the Convex deployment: npx convex env set INWORLD_API_KEY <the-key>
INWORLD_API_KEY=

# Deepgram Nova STT with speaker diarization — https://developers.deepgram.com/docs/diarization
# Also set on the Convex deployment: npx convex env set DEEPGRAM_API_KEY <the-key>
DEEPGRAM_API_KEY=

# TypeSafe / Jev — dashboard key. Canvas AI calls this from the ask_jev tool.
# Also set on the Convex deployment: npx convex env set TYPESAFE_API_KEY <the-key>
TYPESAFE_API_KEY=

# Vercel Blob — Present recordings upload from the browser via a Convex token.
# Dashboard → Storage → Blob → token. Also: npx convex env set BLOB_READ_WRITE_TOKEN <the-token>
BLOB_READ_WRITE_TOKEN=
